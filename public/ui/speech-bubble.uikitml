<!--
  Chitti's speech bubble. A small cloud-style window that floats in front
  of her, centred in her view and above the tour panel, and shows what he
  is saying, so she can read his words while she talks to him by voice.
  The system moves it to sit in front of her and updates the text every
  time he speaks. Panel and ButtonLabel come from the bundled Horizon kit.
  Plain text only: the panel font has no emoji glyphs.
-->
<style>
  .bubble-root {
    flex-direction: column;
    width: 300px;
    background-color: #111827;
    border-color: #2dd4bf;
    border-width: 3px;
    border-radius: 18px;
  }

  .bubble-content {
    flex-direction: column;
    gap: 4px;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 16px;
    padding-right: 16px;
  }

  .bubble-name {
    color: #5eead4;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1.2px;
  }

  .bubble-text {
    color: #f8fafc;
    font-size: 20px;
    font-weight: 600;
    line-height: 26px;
  }
</style>
<Panel id="bubble-root" class="bubble-root">
  <div class="bubble-content">
    <div class="bubble-name">CHITTI SAYS</div>
    <div id="bubble-text" class="bubble-text">Hi! I'm Chitti.</div>
  </div>
</Panel>
